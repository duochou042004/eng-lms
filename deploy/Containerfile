# syntax=docker/dockerfile:1
# Eng-LMS single image (deployment.md §2, ADR-0004): the SPA and the API from one origin.
# Build from the repository root with rootless Podman. `--format docker` keeps the HEALTHCHECK (the OCI format drops it):
#   podman build --format docker -f deploy/Containerfile -t englms:dev .
# Base images are fully qualified and pinned by multi-arch index digest (tech-stack.md §7). Refresh them deliberately.

# --- Stage 1: web/dist (Node 24 + pnpm via corepack) ---------------------------------------------------------------
FROM docker.io/library/node:24-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS web
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CI=true
WORKDIR /src/web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

# --- Stage 2: the Boot jar with the SPA under static/, extracted as layers (Temurin 25 JDK + Maven wrapper) ----------
FROM docker.io/library/eclipse-temurin:25-jdk@sha256:97014c4b396021f9ddb7d592a7dbedb0c4e4215c29e03dc01c393558aefb71c2 AS app
WORKDIR /src/backend
COPY backend/.mvn/ .mvn/
COPY backend/mvnw backend/pom.xml ./
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -ntp dependency:go-offline
COPY backend/src/main/ src/main/
COPY --from=web /src/web/dist/ src/main/resources/static/
# Tests are not compiled or run here: ./scripts/gate.sh and CI run them (Testcontainers cannot run inside a build).
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -ntp package -Dmaven.test.skip=true \
 && java -Djarmode=tools -jar target/englms-*.jar extract --layers --launcher --destination /layers

# --- Stage 3: runtime (Temurin 25 JRE only: no JDK, no Node) ---------------------------------------------------------
FROM docker.io/library/eclipse-temurin:25-jre@sha256:bb036ed6cfdc57e3da7c22634d15f1b840d2caf76183861c80e81ca4b5104abb
RUN groupadd --system --gid 10001 englms \
 && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin englms
WORKDIR /app
# Root-owned and read-only for the app user; least-changing layers first.
COPY --from=app /layers/dependencies/ ./
COPY --from=app /layers/spring-boot-loader/ ./
COPY --from=app /layers/snapshot-dependencies/ ./
COPY --from=app /layers/application/ ./
USER 10001:10001
# Runs with a read-only root filesystem: the only writable path is a tmpfs /tmp (Tomcat work dir, java.io.tmpdir).
EXPOSE 8080 8081
# No curl or wget in the JRE image: bash's /dev/tcp asks the management port for liveness.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8081 && printf 'GET /actuator/health/liveness HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200 '"]
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-Djava.io.tmpdir=/tmp", "org.springframework.boot.loader.launch.JarLauncher"]

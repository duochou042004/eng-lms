{
  "name": "englms-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings && stylelint \"src/**/*.css\" && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest",
    "budget": "node scripts/bundle-budget.mjs",
    "contrast": "node scripts/contrast-check.mjs",
    "api:generate": "openapi-typescript ../api/openapi.json -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@tanstack/react-query": "5.103.2",
    "i18next": "26.4.2",
    "lucide-react": "1.48.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  }
}

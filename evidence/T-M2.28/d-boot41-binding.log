# --- script ---
#!/usr/bin/env bash
# Boot 4.1 binding check (T-M2.28 (d)): the app gets SPRING_DATASOURCE_URL=.../dba plus one extra variable; which database does
# Flyway migrate, and which database and user does the pool (Hikari) use?
cd "$(dirname "$0")/../.."
jar=backend/target/englms-0.0.1-SNAPSHOT.jar
A=jdbc:postgresql://127.0.0.1:55432/dba B=jdbc:postgresql://127.0.0.1:55432/dbb
q() { podman exec t-m228-binding psql -U englms -d "$1" -tAc "$2" 2>/dev/null; }
reset() { for d in dba dbb; do q $d "DROP SCHEMA IF EXISTS app CASCADE" >/dev/null; done; }
case_() {
  local label=$1; shift
  reset
  env -i PATH="$PATH" HOME="$HOME" JAVA_HOME="$JAVA_HOME" SPRING_DATASOURCE_URL=$A SPRING_DATASOURCE_USERNAME=englms SPRING_DATASOURCE_PASSWORD=<throwaway> \
    SERVER_PORT=0 MANAGEMENT_SERVER_PORT=0 "$@" timeout 90 java -jar $jar >.claude/scratch/binding-app.log 2>&1 &
  local pid=$!
  for _ in $(seq 90); do grep -qE "Started [A-Za-z]+Application|APPLICATION FAILED|Application run failed" .claude/scratch/binding-app.log && break; sleep 1; done
  kill $pid 2>/dev/null; wait $pid 2>/dev/null
  local started; started=$(grep -oE "Started [A-Za-z]+Application" .claude/scratch/binding-app.log | head -1)
  local fa fb ua ub
  fa=$(q dba "SELECT count(*) FROM app.flyway_schema_history"); fb=$(q dbb "SELECT count(*) FROM app.flyway_schema_history")
  ua=$(q dba "SELECT DISTINCT installed_by FROM app.flyway_schema_history"); ub=$(q dbb "SELECT DISTINCT installed_by FROM app.flyway_schema_history")
  echo "[$label] ${*:-<none>}"
  echo "    app: ${started:-not started}; Flyway rows dba=${fa:-none} (by ${ua:-}) dbb=${fb:-none} (by ${ub:-})"
  grep -E "HikariPool-1 - Added connection|Database: jdbc|Migrating schema|Successfully applied|APPLICATION FAILED|Failed to|Caused by" .claude/scratch/binding-app.log | head -4 | sed 's/^/    log: /'
}
case_ flyway-url+password SPRING_FLYWAY_URL=$B SPRING_FLYWAY_PASSWORD=<throwaway>
case_ hikari-classname SPRING_DATASOURCE_HIKARI_DATASOURCECLASSNAME=org.postgresql.ds.PGSimpleDataSource SPRING_DATASOURCE_HIKARI_DATASOURCEPROPERTIES_DATABASENAME=dbb SPRING_DATASOURCE_HIKARI_DATASOURCEPROPERTIES_SERVERNAME=127.0.0.1 SPRING_DATASOURCE_HIKARI_DATASOURCEPROPERTIES_PORTNUMBER=55432
case_ application-json "SPRING_APPLICATION_JSON={\"spring\":{\"flyway\":{\"url\":\"$B\",\"password\":\"<throwaway>\"}}}"
case_ hikari-pgdbname-property SPRING_DATASOURCE_HIKARI_DATASOURCEPROPERTIES_PGDBNAME=dbb

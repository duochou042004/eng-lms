// THROWAWAY (T-M1.6 AC4 negative demo; deleted after the run, never committed): each test must FAIL.
import type { Page } from '@playwright/test'
import { expectNoAxeViolations, expectNoHorizontalScroll } from '../support/checks'
import { test } from '../support/fixtures'

async function broken(page: Page, head: string) {
  await page.route('**/tutor', async (route) => {
    const response = await route.fetch()
    await route.fulfill({ response, body: (await response.text()).replace('</head>', `${head}</head>`) })
  })
  await page.goto('/tutor')
}
test('DEMO axe: image without alt', async ({ page }) => {
  await broken(page, '')
  await page.evaluate(() => { const i = document.createElement('img'); i.src = '/favicon.svg'; document.querySelector('main')?.append(i) })
  await expectNoAxeViolations(page)
})
test('DEMO layout: 3000px overflow', async ({ page }) => {
  await broken(page, '')
  await page.evaluate(() => { const d = document.createElement('div'); d.style.width = '3000px'; d.textContent = 'x'; document.body.append(d) })
  await expectNoHorizontalScroll(page)
})
test('DEMO console guard: inline <style> under the CSP', async ({ page }) => {
  await broken(page, '<style>body { outline: 1px solid red; }</style>')
  await page.waitForTimeout(500)
})

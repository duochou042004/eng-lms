# ---- run 2 (2026-09-26T02:48:01Z): run 1's axe demo PASSED because the demo injected the <img> before React rendered <main> (a race in the demo, not in the guard; the committed self-test in tests/guards.spec.ts waits for the heading). Fixed demo:
// THROWAWAY (T-M1.6 AC4 negative demo, run 2; deleted after the run): waits for React to render before injecting.
import type { Page } from '@playwright/test'
import { expectNoAxeViolations } from '../support/checks'
import { expect, test } from '../support/fixtures'

async function rendered(page: Page) {
  await page.goto('/tutor')
  await expect(page.getByRole('heading', { level: 1 })).toBeVisible()
}
test('DEMO axe: image without alt (after render)', async ({ page }) => {
  await rendered(page)
  await page.evaluate(() => { const i = document.createElement('img'); i.src = '/favicon.svg'; document.querySelector('main')?.append(i) })
  await expectNoAxeViolations(page)
})

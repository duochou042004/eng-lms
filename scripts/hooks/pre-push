#!/usr/bin/env bash
# pre-push hook (installed via scripts/install-hooks.sh → core.hooksPath=scripts/hooks).
# Blocks direct pushes to master/develop and any non-fast-forward (force) push (git-governance.md §1, §4; DEC-031).
# One exception (DEC-060): the private GitLab mirror may receive master/develop, but only exactly the local
# refs/remotes/origin/<branch> tracking ref as last fetched from GitHub by scripts/gitlab-sync.sh. It mirrors merge-gate's
# result; like the rest of this local hook it is a guard against mistakes, not against deliberate bypass (--no-verify).
# ENGLMS_MIRROR_URL_RE is a TEST-ONLY override, honoured only for local-path URLs, so it can never widen to a real remote.
set -euo pipefail
zero=0000000000000000000000000000000000000000
remote_url=${2:-}
mirror_url_re='^(https://gitlab\.com/|git@gitlab\.com:)duochou042004/eng-lms(\.git)?$'
if [[ -n "${ENGLMS_MIRROR_URL_RE:-}" && "$remote_url" == /* ]]; then
  mirror_url_re=$ENGLMS_MIRROR_URL_RE
fi
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master|refs/heads/develop)
      branch=${remote_ref#refs/heads/}
      github_sha=$(git rev-parse -q --verify "refs/remotes/origin/$branch" 2>/dev/null || true)
      if [[ "$remote_url" =~ $mirror_url_re && -n "$github_sha" && "$local_sha" == "$github_sha" ]]; then
        : # verified mirror push (still subject to the fast-forward check below)
      else
        echo "pre-push: direct push to '$branch' is blocked. Open a PR and merge with scripts/merge-gate.sh." >&2
        [[ "$remote_url" =~ $mirror_url_re ]] && echo "pre-push: the GitLab mirror only accepts origin/$branch exactly: use scripts/gitlab-sync.sh" >&2
        exit 1
      fi;;
  esac
  [[ "$local_sha" == "$zero" ]] && continue          # branch deletion (non-protected) is allowed
  if [[ "$remote_sha" != "$zero" ]] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: non-fast-forward (force) push to '$remote_ref' is blocked." >&2
    exit 1
  fi
done
exit 0

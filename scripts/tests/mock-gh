#!/usr/bin/env bash
# Fake `gh` for merge-gate tests. Reads fixtures from $MOCK_DIR:
#   pr.json (pr view), checks.json (pr checks), behind.txt (compare behind_by); records merges in merged.txt and every call in calls.txt
#   activity.json (repository activity), runs.json (actions/runs), forcepush.json (graphql timeline), pr-commits.json / pr-files.json (pulls/<n>/commits|files)
#   A fixture file named <name>.fail makes that call exit non-zero (API error → the gate must fail closed).
source "$(dirname "$0")/../lib/require-bash.sh"
set -euo pipefail
echo "$*" >>"$MOCK_DIR/calls.txt"   # every call (T-M1.12 AC4: argument errors must make none)
#   A non-empty .fail file is printed to stderr instead of the default message (e.g. an old gh's "unknown flag: --json").
serve() { if [[ -f "$MOCK_DIR/$1.fail" ]]; then if [[ -s "$MOCK_DIR/$1.fail" ]]; then cat "$MOCK_DIR/$1.fail" >&2; else echo "mock-gh: HTTP 502 for $1" >&2; fi; exit 1; fi; cat "$MOCK_DIR/$1"; }
case "$1 $2" in
  "pr view")   cat "$MOCK_DIR/pr.json" ;;
  "pr checks") serve checks.json ;;
  "pr merge")  echo "$*" >>"$MOCK_DIR/merged.txt"; echo "merged" ;;
  "api "*)
    case "$*" in
      */activity\?*)     serve activity.json ;;
      *actions/runs*)    serve runs.json ;;
      *" graphql "*)     serve forcepush.json ;;
      *pulls/*/commits*) serve pr-commits.json ;;
      *pulls/*/files*)   serve pr-files.json ;;
      *compare/*)        cat "$MOCK_DIR/behind.txt" ;;
      *) echo "mock-gh: unsupported api call: $*" >&2; exit 2 ;;
    esac ;;
  *) echo "mock-gh: unsupported: $*" >&2; exit 2 ;;
esac

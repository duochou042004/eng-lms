  "components" : {
    "schemas" : {
      "ChangePasswordRequest" : {
        "type" : "object",
        "properties" : {
          "currentPassword" : {
            "type" : "string"
          },
          "newPassword" : {
            "type" : "string"
          }
        },
        "required" : [ "currentPassword", "newPassword" ]
      },
      "ContactHandle" : {
        "type" : "object",
        "properties" : {
          "label" : {
            "type" : "string"
          },
          "value" : {
            "type" : "string"
          }
        }
      },
      "CreateStudentRequest" : {
        "type" : "object",
        "properties" : {
          "contactHandles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ContactHandle"
            }
          },
          "email" : {
            "type" : "string"
          },
          "fullName" : {
            "type" : "string"
          },
          "guardians" : {
            "type" : "array",
            "description" : "Optional, at most 10; created in the same transaction, listed by GET …/guardians",
            "items" : {
              "$ref" : "#/components/schemas/GuardianRequest"
            }
          },
          "note" : {
            "type" : "string"

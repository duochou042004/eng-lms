{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Eng-LMS API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Same origin"
  } ],
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            },
            "description" : "Signed in"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "UNAUTHENTICATED: one generic answer for every failure"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "CSRF_INVALID"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "RATE_LIMITED, with Retry-After"
          }
        },
        "summary" : "Sign in with username and password; rotates the session ID",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "Signed out"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "CSRF_INVALID"
          }
        },
        "summary" : "End this session and this device's remember-me token (idempotent)",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/password" : {
      "post" : {
        "operationId" : "changePassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Changed; the session ID rotated"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "UNAUTHENTICATED or SESSION_EXPIRED"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "CSRF_INVALID"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "VALIDATION_FAILED with errors[] (CURRENT_PASSWORD_INCORRECT, PASSWORD_TOO_SHORT, PASSWORD_TOO_LONG, PASSWORD_TOO_COMMON, PASSWORD_EQUALS_USERNAME, PASSWORD_UNCHANGED)"
          }
        },
        "summary" : "Change the own password; ends every other session and remember-me token",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/session" : {
      "get" : {
        "operationId" : "session",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            },
            "description" : "Signed in"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "UNAUTHENTICATED (no session cookie) or SESSION_EXPIRED"
          }
        },
        "summary" : "The signed-in user; also sets the XSRF-TOKEN cookie, for anonymous callers too",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/meta" : {
      "get" : {
        "operationId" : "meta",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MetaResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "meta" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ChangePasswordRequest" : {
        "type" : "object",
        "properties" : {
          "currentPassword" : {
            "type" : "string"
          },
          "newPassword" : {
            "type" : "string"
          }
        },
        "required" : [ "currentPassword", "newPassword" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "password" : {
            "type" : "string"
          },
          "rememberMe" : {
            "type" : "boolean"
          },
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "password", "username" ]
      },
      "MetaResponse" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "locales" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "name" : {
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          }
        },
        "required" : [ "displayName", "locales", "name", "version" ]
      },
      "Problem" : {
        "type" : "object",
        "description" : "RFC 9457 Problem Details (api-conventions.md §5)",
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ProblemCode"
          },
          "errors" : {
            "type" : "array",
            "description" : "Field errors of a 422 VALIDATION_FAILED",
            "items" : {
              "type" : "object",
              "properties" : {
                "code" : {
                  "$ref" : "#/components/schemas/ProblemCode"
                },
                "field" : {
                  "type" : "string"
                },
                "message" : {
                  "type" : "string"
                }
              },
              "required" : [ "code", "field" ]
            }
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "requestId" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        },
        "required" : [ "code", "requestId", "status", "title", "type" ]
      },
      "ProblemCode" : {
        "type" : "string",
        "enum" : [ "MALFORMED_REQUEST", "NOT_FOUND", "METHOD_NOT_ALLOWED", "UNSUPPORTED_MEDIA_TYPE", "NOT_ACCEPTABLE", "VALIDATION_FAILED", "INTERNAL_ERROR", "UNAUTHENTICATED", "SESSION_EXPIRED", "FORBIDDEN_ROLE", "PASSWORD_CHANGE_REQUIRED", "CSRF_INVALID", "RATE_LIMITED", "PASSWORD_TOO_SHORT", "PASSWORD_TOO_LONG", "PASSWORD_TOO_COMMON", "PASSWORD_EQUALS_USERNAME", "PASSWORD_UNCHANGED", "CURRENT_PASSWORD_INCORRECT" ]
      },
      "SessionResponse" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : [ "string", "null" ]
          },
          "locale" : {
            "type" : "string"
          },
          "mustChangePassword" : {
            "type" : "boolean"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "TUTOR", "STUDENT" ]
          },
          "timeZone" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "displayName", "locale", "mustChangePassword", "role", "timeZone", "userId", "username" ]
      }
    }
  }
}

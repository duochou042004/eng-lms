# Local development only (T-M1.4). Copy to .env (git-ignored) and adjust. Never put real or production secrets here.
ENGLMS_DEV_DB_NAME=englms
ENGLMS_DEV_DB_USER=englms
ENGLMS_DEV_DB_PASSWORD=change-me-dev-only
ENGLMS_DEV_DB_PORT=5432

# Read by the backend (./mvnw spring-boot:run): export them, e.g. `set -a; source .env; set +a`.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/englms
SPRING_DATASOURCE_USERNAME=englms
SPRING_DATASOURCE_PASSWORD=change-me-dev-only
